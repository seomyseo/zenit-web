# Variables de BUILD (se incrustan al compilar; Docker las recibe como build.args).
# Copiar a .env (que NO va a git) y completar. Tras cambiarlas: docker compose up -d --build

# URL pública del sitio, sin barra final (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=

# Enlace de WhatsApp comercial, formato https://wa.me/58XXXXXXXXXX (sin +, sin espacios).
# El mensaje se precarga solo. Si se deja vacío, el botón lleva a Instagram.
NEXT_PUBLIC_WHATSAPP_URL=

# "true" para permitir que los buscadores indexen el sitio. Cualquier otro valor
# (o vacío) publica robots.txt con Disallow y meta noindex en todas las páginas.
NEXT_PUBLIC_SITE_INDEXABLE=
