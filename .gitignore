# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Fuentes originales (fichas, empaques, fotos): ~78 MB, se guardan fuera de git.
# Solo se versiona el manual de marca. Las imágenes publicables están en public/products/.
/content/source/*
!/content/source/brand/

# capturas de revisión de diseño
/.screenshots/

# Bundle del servicio zenit-api (pnpm build:api)
services/zenit-api/dist/
