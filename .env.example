# URL pública del sitio (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://zenit.com.ve

# Webhook de n8n que recibe los leads (POST JSON). Solo servidor.
# Si falta en desarrollo, el formulario acepta el envío y avisa por consola
# sin imprimir datos personales. En producción, sin webhook el envío falla
# con un error claro y se ofrece WhatsApp.
LEADS_WEBHOOK_URL=

# Enlace de WhatsApp comercial (https://wa.me/58XXXXXXXXXX). Número pendiente.
# Si está vacío, no se muestra el botón.
NEXT_PUBLIC_WHATSAPP_URL=
