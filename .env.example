# Copiar a .env (que NO va a git) y completar. Hay dos tipos de variables:

# ── Sitio (zenit-web): variables de BUILD ─────────────────────────────────────────
# Se incrustan al compilar (Docker las recibe como build.args).
# Tras cambiarlas: docker compose up -d --build

# URL pública del sitio, sin barra final (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=

# WhatsApp comercial, formato https://wa.me/58XXXXXXXXXX (código de país + número,
# sin "+", sin espacios ni guiones). El mensaje se precarga solo.
# Vacía: se usa el número oficial que fija lib/env.ts.
NEXT_PUBLIC_WHATSAPP_URL=

# PRODUCCIÓN: true (indexable, robots.txt abierto con Sitemap, sitemap.xml publicado).
# Entornos de prueba: false o vacía (noindex en todas las páginas, robots.txt con
# Disallow: / y sin sitemap). Vacía equivale a false, para no indexar por accidente.
NEXT_PUBLIC_SITE_INDEXABLE=

# ── Formulario de contacto (zenit-api): variables de EJECUCIÓN ─────────────────────
# No se incrustan en el sitio: solo las lee el contenedor zenit-api.
# Tras cambiarlas basta con: docker compose up -d zenit-api
# Si un valor tiene "$", ponerlo entre comillas simples: SMTP_PASS='abc$123'

# Servidor SMTP del correo de Lefre. Puerto 587 (STARTTLS) o 465 (TLS directo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Remitente: una dirección de un dominio CON correo propio (p. ej. @lefre.com.ve),
# NUNCA @zenit.com.ve (no tiene correo ni SPF/DKIM: caería en spam).
# El correo del visitante va en Reply-To: "Responder" le escribe a él.
# Formato: MAIL_FROM="Sitio Zenit <usuario@lefre.com.ve>"
MAIL_FROM=

# Destino de los formularios.
MAIL_TO=mercadeo@lefre.com.ve

# ── Opcional: basicAuth de Traefik (ver README) ────────────────────────────────────
# ZENIT_BASIC_AUTH_USERS=
